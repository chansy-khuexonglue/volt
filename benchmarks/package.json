{
  "name": "@volt/benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "High-throughput performance benchmark suite comparing Volt with Elysia, Hono, Bun.serve, Fastify, Express, and NestJS",
  "type": "module",
  "scripts": {
    "test": "bun test test/",
    "bench": "bun run benchmark.ts",
    "bench:compare": "bun run runner.ts",
    "bench:all": "bun run all-frameworks.ts"
  },
  "dependencies": {
    "volt": "workspace:*",
    "@volt/core": "workspace:*",
    "@volt/testing": "workspace:*",
    "@volt/validator": "workspace:*",
    "elysia": "^1.4.30",
    "hono": "^4.13.14",
    "fastify": "^5.12.7",
    "express": "^5.3.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5"
  }
