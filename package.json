{
  "name": "volt-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance TypeScript-first API framework built for Bun",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "examples/*",
    "examples/ecommerce/*",
    "benchmarks"
  ],
  "scripts": {
    "dev": "bun --watch examples/basic-api/index.ts",
    "dev:hello": "bun --watch examples/hello-world/index.ts",
    "dev:rest": "bun --watch examples/rest-api/src/index.ts",
    "dev:auth": "bun --watch examples/authentication/index.ts",
    "dev:ecommerce:api": "bun --watch examples/ecommerce/api/src/index.ts",
    "dev:ecommerce:web": "bun --cwd examples/ecommerce/web dev",
    "dev:docs": "bun --cwd web dev --port 3002",
    "start": "bun run examples/basic-api/index.ts",
    "test": "bun test packages/*/test packages/plugins/*/test examples/*/test examples/ecommerce/*/test benchmarks/test",
    "test:examples": "bun test examples/*/test examples/ecommerce/*/test",
    "test:benchmarks": "bun test benchmarks/test",
    "bench": "bun run benchmarks/benchmark.ts",
    "bench:compare": "bun run benchmarks/runner.ts",
    "bench:all": "bun run benchmarks/all-frameworks.ts",
    "typecheck": "tsc --noEmit",
    "git:status": "bash .agents/skills/git-commit-push/scripts/status.sh",
    "git:push": "bash .agents/skills/git-commit-push/scripts/push.sh",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} +"
  },
  "devDependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "elysia": "^1.4.30",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "graphql": "^17.0.2",
    "hono": "^4.13.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.8.2"
  }
}
